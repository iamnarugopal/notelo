{
  "expo": {
    "name": "Notelo",
    "slug": "Notelo",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "notelo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dev007pravesh.Notelo"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.dev007pravesh.Notelo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#22b6c6",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#22b6c6"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bc555ee-992f-4c76-bafa-665d3e8fe1ad"
      }
    },
    "owner": "iamnarugopal"
  }
}
